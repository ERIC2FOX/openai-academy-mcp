PORT=3000
# Required for a remote deployment. Use an HTTPS URL in production.
PUBLIC_BASE_URL=http://localhost:3000
ACADEMY_BASE_URL=https://academy.openai.com
# Set only after verifying that the public URL exists and is permitted by robots.txt.
# A sitemap is treated as a public web document, not as an Academy API.
ACADEMY_SITEMAP_URL=
REQUEST_TIMEOUT_MS=15000
MAX_SEARCH_RESULTS=20
MAX_RESPONSE_BYTES=1000000
CACHE_TTL_MS=300000
USER_AGENT=OpenAI-Academy-Connector/1.0 (+https://example.invalid/contact)
